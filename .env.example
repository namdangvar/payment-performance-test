# ── Wallet-api connection (copy from qday-payment-e2e-harness/.env) ──
WALLET_API_URL=http://localhost:3003
JWT_SECRET=replace-me

# ── Owner key (same as harness OWNER_PRIVATE_KEY) ──
OWNER_PRIVATE_KEY=

# ── wallet-api IDs — find these after running the full harness setup ──
# ACCOUNT_ID: UUID from the JWT payload (field "sub") after login
# QPASS_ID:   UUID from `qpass qpass` CLI output or wallet-api GET /v1/qpass
ACCOUNT_ID=
QPASS_ID=

# ── Chain RPC for bench-pay.js ──
QDAY_ENV=develop
# Or override explicitly:
# CHAIN_ID=44005
# RPC_URL=https://rpc-test.qday.info
# USD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483

# ── Optional session caps (atomic units, 6 decimals) ──
# BENCH_PER_TX_CAP=1000000   (1 tUSD8)
# BENCH_TOTAL_CAP=1000000    (1 tUSD8)
# BENCH_EXPIRES_IN=3600      (1 hour)
